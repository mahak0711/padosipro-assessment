# Server
PORT=4000
NODE_ENV=development

# Database (SQLite file path, used by Prisma)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# OTP
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Email
# MODE=ethereal creates a free, auto-generated test inbox on every boot and logs
# a preview URL for every email sent (no signup / credentials needed).
# MODE=smtp uses the SMTP_* settings below (e.g. Mailpit running locally, or a real provider).
EMAIL_MODE=ethereal
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PadosiPro <no-reply@padosipro.local>"
